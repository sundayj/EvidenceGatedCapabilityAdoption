{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sundayj/EvidenceGatedCapabilityAdoption/schemas/experiment.schema.json",
  "title": "EGCA Experiment",
  "type": "object",
  "required": [
    "experiment_id",
    "candidate_id",
    "title",
    "hypothesis",
    "scope",
    "success_evidence",
    "rejection_evidence",
    "status"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^E-[0-9]{3,}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^C-[0-9]{3,}$"
    },
    "governing_methodology": {
      "oneOf": [
        {"$ref": "#/$defs/versionedSource"},
        {"type": "null"}
      ]
    },
    "governing_policies": {
      "type": "array",
      "items": {"$ref": "#/$defs/versionedSource"},
      "default": []
    },
    "criteria_revision": {
      "type": ["string", "null"]
    },
    "transition_mandate": {
      "oneOf": [
        {"$ref": "#/$defs/transitionMandate"},
        {"type": "null"}
      ]
    },
    "title": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "tested_artifact": {
      "type": ["string", "null"]
    },
    "tested_environment": {
      "type": ["string", "null"]
    },
    "evidence_applicability_boundary": {
      "type": ["string", "null"]
    },
    "productionization_delta": {
      "type": ["string", "null"]
    },
    "productionization_status": {
      "type": ["string", "null"],
      "enum": [
        "Not required",
        "Required",
        "Planned",
        "Running",
        "Validated",
        "Blocked",
        "Deferred",
        null
      ]
    },
    "out_of_scope": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "success_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "rejection_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "depends_on": {
      "type": "array",
      "items": {"type": "string", "pattern": "^E-[0-9]{3,}$"},
      "uniqueItems": true,
      "default": []
    },
    "execution_priority": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "status": {
      "type": "string",
      "enum": ["Planned", "Approved", "Admitted", "Running", "Validating", "Complete", "Blocked"]
    },
    "repository_references": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "adversarial_evidence": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "self_validation_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceReference"},
      "default": []
    },
    "independent_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceReference"},
      "default": []
    },
    "criterion_traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "production_code_path": {"type": ["string", "null"]},
          "automated_evidence": {
            "type": "array",
            "items": {"type": "string"},
            "default": []
          },
          "branch_matched_runtime_evidence": {
            "type": "array",
            "items": {"type": "string"},
            "default": []
          },
          "residual_boundary": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      },
      "default": []
    },
    "execution_telemetry": {
      "type": "object",
      "properties": {
        "executor": {
          "type": ["string", "null"]
        },
        "started_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "completed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "wall_clock_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "agent_elapsed_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "human_active_minutes": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "human_interventions": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "primary_model": {
          "type": ["string", "null"]
        },
        "reasoning_level": {
          "type": ["string", "null"]
        },
        "agent_runs": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "rework_runs": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "delegation_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "usage": {
          "type": ["object", "null"],
          "properties": {
            "value": {},
            "unit": {"type": ["string", "null"]},
            "source": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        },
        "execution_ledger_reference": {
          "type": ["string", "null"]
        },
        "measurement_confidence": {
          "type": ["string", "null"],
          "enum": ["High", "Medium", "Low", null]
        },
        "provenance": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    },
    "observed_evidence": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "decision": {
      "oneOf": [
        {"type": "string", "enum": ["Adopt", "Adapt", "Reject", "Repeat"]},
        {"type": "null"}
      ]
    },
    "transition_outcome": {
      "oneOf": [
        {"type": "string", "enum": ["Admit", "Adapt", "Repeat", "Reject", "ExternalBlock"]},
        {"type": "null"}
      ]
    },
    "transition_object_revision": {
      "type": ["string", "integer", "null"]
    },
    "external_block": {
      "oneOf": [
        {"$ref": "#/$defs/externalBlock"},
        {"type": "null"}
      ]
    },
    "rationale": {
      "oneOf": [
        {"type": "string"},
        {"type": "null"}
      ]
    },
    "follow_up": {
      "oneOf": [
        {"type": "string"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "versionedSource": {
      "type": "object",
      "required": ["id", "version", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "transitionMandate": {
      "type": "object",
      "required": ["id", "revision", "objective_refs", "action", "object_ref", "object_revision", "authority_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "objective_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "action": {"type": "string", "minLength": 1},
        "object_ref": {"type": "string", "minLength": 1},
        "object_revision": {"type": ["string", "integer"]},
        "authority_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "valid_until": {"type": ["string", "null"], "format": "date-time"},
        "stop_conditions": {
          "type": "array",
          "items": {"type": "string"},
          "default": []
        },
        "rollback_conditions": {
          "type": "array",
          "items": {"type": "string"},
          "default": []
        },
        "synthesizer_provenance": {"type": ["string", "null"]},
        "audit_provenance": {
          "type": "array",
          "items": {"type": "string"},
          "default": []
        }
      },
      "additionalProperties": true
    },
    "evidenceReference": {
      "type": "object",
      "required": ["reference", "producer", "provenance_domain"],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "producer": {"type": "string", "minLength": 1},
        "provenance_domain": {"type": "string", "minLength": 1},
        "artifact_digest": {"type": ["string", "null"]},
        "subject_revision": {"type": ["string", "integer", "null"]},
        "criteria_revision": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "externalBlock": {
      "type": "object",
      "required": ["authority_source", "required_action", "reason"],
      "properties": {
        "authority_source": {"type": "string", "minLength": 1},
        "required_action": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "unavailable_principal": {"type": ["string", "null"]},
        "recheck_condition": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "Complete"}},
        "required": ["status"]
      },
      "then": {
        "required": ["decision", "observed_evidence"]
      }
    },
    {
      "if": {
        "properties": {
          "transition_outcome": {
            "type": "string"
          }
        },
        "required": ["transition_outcome"]
      },
      "then": {
        "required": [
          "governing_methodology",
          "criteria_revision",
          "transition_mandate",
          "transition_object_revision"
        ],
        "properties": {
          "governing_methodology": {"$ref": "#/$defs/versionedSource"},
          "criteria_revision": {"type": "string", "minLength": 1},
          "transition_mandate": {"$ref": "#/$defs/transitionMandate"},
          "transition_object_revision": {"type": ["string", "integer"]}
        }
      }
    },
    {
      "if": {
        "properties": {"transition_outcome": {"const": "ExternalBlock"}},
        "required": ["transition_outcome"]
      },
      "then": {
        "required": ["external_block"],
        "properties": {
          "external_block": {"$ref": "#/$defs/externalBlock"}
        }
      }
    }
  ],
  "additionalProperties": true
}
