{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sundayj/EvidenceGatedCapabilityAdoption/schemas/experiment.schema.json",
  "title": "EGCA Experiment",
  "type": "object",
  "required": [
    "experiment_id",
    "candidate_id",
    "title",
    "hypothesis",
    "scope",
    "success_evidence",
    "rejection_evidence",
    "status"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^E-[0-9]{3,}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^C-[0-9]{3,}$"
    },
    "title": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "out_of_scope": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "success_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "rejection_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "depends_on": {
      "type": "array",
      "items": {"type": "string", "pattern": "^E-[0-9]{3,}$"},
      "uniqueItems": true,
      "default": []
    },
    "execution_priority": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "status": {
      "type": "string",
      "enum": ["Planned", "Approved", "Running", "Validating", "Complete", "Blocked"]
    },
    "repository_references": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "execution_telemetry": {
      "type": "object",
      "properties": {
        "executor": {
          "type": ["string", "null"]
        },
        "started_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "completed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "wall_clock_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "agent_elapsed_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "human_active_minutes": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "human_interventions": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "primary_model": {
          "type": ["string", "null"]
        },
        "reasoning_level": {
          "type": ["string", "null"]
        },
        "agent_runs": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "rework_runs": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "delegation_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "usage": {
          "type": ["object", "null"],
          "properties": {
            "value": {},
            "unit": {"type": ["string", "null"]},
            "source": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        },
        "execution_ledger_reference": {
          "type": ["string", "null"]
        },
        "measurement_confidence": {
          "type": ["string", "null"],
          "enum": ["High", "Medium", "Low", null]
        },
        "provenance": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    },
    "observed_evidence": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "decision": {
      "oneOf": [
        {"type": "string", "enum": ["Adopt", "Adapt", "Reject", "Repeat"]},
        {"type": "null"}
      ]
    },
    "rationale": {
      "oneOf": [
        {"type": "string"},
        {"type": "null"}
      ]
    },
    "follow_up": {
      "oneOf": [
        {"type": "string"},
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "Complete"}},
        "required": ["status"]
      },
      "then": {
        "required": ["decision", "observed_evidence"]
      }
    }
  ],
  "additionalProperties": true
}
