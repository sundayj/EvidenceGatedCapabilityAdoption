{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sundayj/EvidenceGatedCapabilityAdoption/schemas/autonomy-transition.schema.json",
  "title": "EGCA Evidence-Derived Transition Request",
  "description": "Experimental E-001 interchange record. It expresses evidence and authority for a proposed transition; it does not itself authenticate provenance or perform the transition.",
  "type": "object",
  "required": [
    "transition_id",
    "program_id",
    "criteria_revision",
    "subject",
    "object",
    "transition",
    "governance",
    "mandate",
    "criteria",
    "evidence",
    "findings"
  ],
  "properties": {
    "transition_id": {"type": "string", "minLength": 1},
    "program_id": {"type": "string", "minLength": 1},
    "criteria_revision": {"type": "string", "minLength": 1},
    "subject": {"$ref": "#/$defs/versionedSource"},
    "object": {
      "type": "object",
      "required": ["id", "type", "current_revision", "expected_revision", "next_revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "current_revision": {"type": "integer", "minimum": 0},
        "expected_revision": {"type": "integer", "minimum": 0},
        "next_revision": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": ["action", "from_state", "to_state"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "from_state": {"type": "string", "minLength": 1},
        "to_state": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "required": ["current", "governing_sources"],
      "properties": {
        "current": {"$ref": "#/$defs/versionedSource"},
        "candidate": {
          "oneOf": [
            {"$ref": "#/$defs/versionedSource"},
            {"type": "null"}
          ]
        },
        "governing_sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/versionedSource"}
        }
      },
      "additionalProperties": false
    },
    "mandate": {
      "type": "object",
      "required": ["synthesized_by", "objective_refs", "policy_refs", "authority"],
      "properties": {
        "synthesized_by": {"type": "string", "minLength": 1},
        "objective_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/versionedSource"}
        },
        "policy_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/versionedSource"}
        },
        "authority": {
          "type": "array",
          "items": {"$ref": "#/$defs/authority"}
        }
      },
      "additionalProperties": false
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "minimum_supporting_evidence", "minimum_independent_domains"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "minimum_supporting_evidence": {"type": "integer", "minimum": 1},
          "minimum_independent_domains": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "versionedSource": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "actions",
        "from_states",
        "to_states",
        "valid_from",
        "valid_until",
        "enforcement",
        "status"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/versionedSource"},
        "target": {"type": "string", "minLength": 1},
        "actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "from_states": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "to_states": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "enforcement": {"type": "string", "enum": ["internal", "external"]},
        "status": {"type": "string", "enum": ["active", "inactive", "unavailable", "revoked"]}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "criterion_ids",
        "effect",
        "verified",
        "producer_id",
        "producer_kind",
        "independence_domain",
        "self_attestation",
        "subject_revision",
        "criteria_revision",
        "artifact_ref",
        "artifact_digest"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "criterion_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "effect": {"type": "string", "enum": ["supports", "refutes"]},
        "verified": {"type": "boolean"},
        "producer_id": {"type": "string", "minLength": 1},
        "producer_kind": {"type": "string", "minLength": 1},
        "independence_domain": {"type": "string", "minLength": 1},
        "self_attestation": {"type": "boolean"},
        "subject_revision": {"type": "integer", "minimum": 0},
        "criteria_revision": {"type": "string", "minLength": 1},
        "artifact_ref": {"type": "string", "minLength": 1},
        "artifact_digest": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "severity", "status", "remediable", "authority_external"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "enum": ["advisory", "blocking"]},
        "status": {"type": "string", "enum": ["open", "resolved"]},
        "remediable": {"type": "boolean"},
        "authority_external": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
